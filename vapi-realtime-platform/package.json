{
  "name": "vapi-realtime-platform",
  "version": "0.1.0",
  "description": "Real-time, multi-tenant API layer that Vapi calls during live phone calls (knowledge, calendar, business-hours, emergency routing, customer validation). Background automation lives in n8n, not here.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "provision": "tsx scripts/provisionAssistant.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@pinecone-database/pinecone": "^2.2.2",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "googleapis": "^140.0.1",
    "ioredis": "^5.4.1",
    "openai": "^4.56.0",
    "opossum": "^8.1.4",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/opossum": "^8.1.8",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
