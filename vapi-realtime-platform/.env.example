# ---- Server ----
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Shared secret Vapi sends back on every webhook call (Vapi dashboard -> Assistant -> Server -> Secret).
# Verified on every request; requests without a matching value are rejected before any business logic runs.
VAPI_WEBHOOK_SECRET=

# ---- Supabase (system of record: businesses, locations, customers, appointments, audit log) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis (hot-path cache, rate limiting, idempotency, tenant-resolution cache) ----
REDIS_URL=redis://localhost:6379

# ---- Pinecone (knowledge base vectors, one namespace per business) ----
PINECONE_API_KEY=
PINECONE_INDEX=ai-receptionist-kb

# ---- OpenAI (embeddings ONLY for /knowledge/search fallback path; Vapi holds its own model key for conversation) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Google Calendar (per-location OAuth2 refresh tokens are stored in Supabase `calendars`, these are the app-level client credentials) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- n8n (background automation only — fire-and-forget, never awaited in the request/response path) ----
N8N_BACKGROUND_WEBHOOK_URL=
N8N_WEBHOOK_SHARED_SECRET=

# ---- Latency / reliability budgets (ms) ----
KNOWLEDGE_SEARCH_TIMEOUT_MS=450
CALENDAR_TIMEOUT_MS=900
DOWNSTREAM_RETRY_COUNT=1
CIRCUIT_BREAKER_ERROR_THRESHOLD_PCT=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
