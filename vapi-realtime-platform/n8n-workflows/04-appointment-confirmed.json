{
  "name": "[MASTER] Appointment Confirmed (Staff-Triggered)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointment-confirmed",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "ac1-webhook",
      "name": "Appointment Confirmed Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "appointment-confirmed-master",
      "notes": "NOT called by the phone system. This fires when a STAFF MEMBER actually confirms a tentative booking — e.g. a GoHighLevel automation calling this webhook when the appointment's pipeline stage is moved to 'Confirmed', or any simple staff-facing 'Confirm' button/form you point at this URL. Send the same fields as appointment-booked (businessId, appointmentId, businessName, customer, startTime, serviceType, ghlContactId, slackChannel)."
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "businessId", "type": "string", "value": "={{ $json.body.businessId }}" },
            { "id": "a2", "name": "appointmentId", "type": "string", "value": "={{ $json.body.appointmentId }}" },
            { "id": "a8", "name": "businessName", "type": "string", "value": "={{ $json.body.businessName }}" },
            { "id": "a3", "name": "customerName", "type": "string", "value": "={{ $json.body.customer.name }}" },
            { "id": "a4", "name": "customerPhone", "type": "string", "value": "={{ $json.body.customer.phone }}" },
            { "id": "a5", "name": "customerEmail", "type": "string", "value": "={{ $json.body.customer.email }}" },
            { "id": "a6", "name": "startTime", "type": "string", "value": "={{ $json.body.startTime }}" },
            { "id": "a7", "name": "serviceType", "type": "string", "value": "={{ $json.body.serviceType }}" },
            { "id": "a9", "name": "ghlContactId", "type": "string", "value": "={{ $json.body.ghlContactId }}" },
            { "id": "a11", "name": "slackChannel", "type": "string", "value": "={{ $json.body.slackChannel || '#bookings' }}" }
          ]
        },
        "options": {}
      },
      "id": "ac2-normalize",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "send",
        "from": "={{ $env.TWILIO_FROM_NUMBER }}",
        "to": "={{ $json.customerPhone }}",
        "message": "=Hi {{ $json.customerName }}, your {{ $json.serviceType }} appointment with {{ $json.businessName }} is confirmed for {{ $json.startTime }}. Reply CANCEL to cancel.",
        "onError": "continueErrorOutput"
      },
      "id": "ac4-sms",
      "name": "Send Confirmation SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [440, 220],
      "onError": "continueErrorOutput",
      "credentials": {
        "twilioApi": { "id": "PLACEHOLDER_TWILIO_CRED", "name": "Twilio account" }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.customerEmail }}",
        "subject": "=Your appointment with {{ $json.businessName }} is confirmed",
        "message": "=Hi {{ $json.customerName }},<br><br>This confirms your {{ $json.serviceType }} appointment on {{ $json.startTime }}.<br><br>See you then!<br>{{ $json.businessName }}",
        "options": {},
        "onError": "continueErrorOutput"
      },
      "id": "ac5-email",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [660, 220],
      "onError": "continueErrorOutput",
      "credentials": {
        "gmailOAuth2": { "id": "PLACEHOLDER_GMAIL_CRED", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "g1",
              "leftValue": "={{ $json.ghlContactId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ac12-has-ghl",
      "name": "Has GHL Contact?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $json.ghlContactId }}/notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Version", "value": "2021-07-28" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: 'Appointment CONFIRMED: ' + $json.serviceType + ' on ' + $json.startTime }) }}",
        "options": { "timeout": 5000 },
        "onError": "continueErrorOutput"
      },
      "id": "ac6-update-ghl",
      "name": "Update GHL Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 220],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_GHL_CRED", "name": "Go High Level API" }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "appointments",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [{ "keyName": "id", "condition": "eq", "keyValue": "={{ $json.appointmentId }}" }]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "status", "fieldValue": "confirmed" },
            { "fieldId": "confirmation_sent_at", "fieldValue": "={{ $now.toISO() }}" }
          ]
        },
        "onError": "continueErrorOutput"
      },
      "id": "ac7-mark-confirmed",
      "name": "Mark Confirmed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1320, 300],
      "onError": "continueErrorOutput",
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "audit_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "business_id", "fieldValue": "={{ $json.businessId }}" },
            { "fieldId": "event_type", "fieldValue": "appointment_confirmed_processed" },
            { "fieldId": "reference_id", "fieldValue": "={{ $json.appointmentId }}" }
          ]
        }
      },
      "id": "ac8-audit-log",
      "name": "Audit Log",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1540, 300],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "workflow_execution_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "workflow_name", "fieldValue": "appointment-confirmed" },
            { "fieldId": "business_id", "fieldValue": "={{ $json.businessId }}" },
            { "fieldId": "reference_id", "fieldValue": "={{ $json.appointmentId }}" },
            { "fieldId": "status", "fieldValue": "success" }
          ]
        }
      },
      "id": "ac9-workflow-log",
      "name": "Workflow Log",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1760, 300],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "workflow_errors",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "workflow_name", "fieldValue": "appointment-confirmed" },
            { "fieldId": "node_name", "fieldValue": "={{ $json.error?.node?.name || 'unknown' }}" },
            { "fieldId": "error_message", "fieldValue": "={{ $json.error?.message || 'unknown error' }}" },
            { "fieldId": "raw_payload", "fieldValue": "={{ JSON.stringify($json) }}" }
          ]
        }
      },
      "id": "ac10-handle-failure",
      "name": "Handle Failure",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [880, 480],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": "#automation-alerts",
        "text": "=⚠️ appointment-confirmed workflow failed for appointment {{ $json.appointmentId || 'unknown' }} — check workflow_errors table.",
        "otherOptions": {}
      },
      "id": "ac11-alert-slack",
      "name": "Alert Engineering",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1100, 480],
      "credentials": {
        "slackApi": { "id": "PLACEHOLDER_SLACK_CRED", "name": "Slack account" }
      }
    }
  ],
  "connections": {
    "Appointment Confirmed Trigger": { "main": [[{ "node": "Normalize Payload", "type": "main", "index": 0 }]] },
    "Normalize Payload": { "main": [[{ "node": "Send Confirmation SMS", "type": "main", "index": 0 }]] },
    "Send Confirmation SMS": {
      "main": [
        [{ "node": "Send Confirmation Email", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Send Confirmation Email": {
      "main": [
        [{ "node": "Has GHL Contact?", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Has GHL Contact?": {
      "main": [
        [{ "node": "Update GHL Note", "type": "main", "index": 0 }],
        [{ "node": "Mark Confirmed", "type": "main", "index": 0 }]
      ]
    },
    "Update GHL Note": {
      "main": [
        [{ "node": "Mark Confirmed", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Mark Confirmed": {
      "main": [
        [{ "node": "Audit Log", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Audit Log": { "main": [[{ "node": "Workflow Log", "type": "main", "index": 0 }]] },
    "Handle Failure": { "main": [[{ "node": "Alert Engineering", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
