{
  "name": "[MASTER] Emergency Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "emergency-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "eg1-webhook",
      "name": "Emergency Logged Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "emergency-alert-master",
      "notes": "Fires the instant the phone assistant flags an emergency. The assistant may have ALREADY live-transferred the caller (see `action`) — this workflow's job is purely to make sure a human on your team also finds out immediately, on record."
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "businessId", "type": "string", "value": "={{ $json.body.businessId }}" },
            { "id": "e2", "name": "businessName", "type": "string", "value": "={{ $json.body.businessName }}" },
            { "id": "e3", "name": "callerPhone", "type": "string", "value": "={{ $json.body.callerPhone }}" },
            { "id": "e4", "name": "issueSummary", "type": "string", "value": "={{ $json.body.issueSummary }}" },
            { "id": "e5", "name": "severity", "type": "string", "value": "={{ $json.body.severity }}" },
            { "id": "e6", "name": "action", "type": "string", "value": "={{ $json.body.action }}" },
            { "id": "e7", "name": "sheetId", "type": "string", "value": "={{ $json.body.sheetId }}" },
            { "id": "e9", "name": "slackChannel", "type": "string", "value": "={{ $json.body.slackChannel || '#emergencies' }}" }
          ]
        },
        "options": {}
      },
      "id": "eg2-normalize",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "send",
        "from": "={{ $env.TWILIO_FROM_NUMBER }}",
        "to": "={{ $env.FRONT_DESK_ALERT_PHONE }}",
        "message": "=🚨 EMERGENCY — {{ $json.businessName }}: caller {{ $json.callerPhone }}. {{ $json.issueSummary }}. Severity: {{ $json.severity }}. {{ $json.action === 'live_transfer' ? 'Caller was transferred live.' : 'Caller was NOT transferred — please call them back now.' }}",
        "onError": "continueErrorOutput"
      },
      "id": "eg3-sms-frontdesk",
      "name": "SMS On-Call Staff",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [440, 220],
      "onError": "continueErrorOutput",
      "credentials": {
        "twilioApi": { "id": "PLACEHOLDER_TWILIO_CRED", "name": "Twilio account" }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $env.FRONT_DESK_ALERT_EMAIL }}",
        "subject": "=🚨 EMERGENCY — {{ $json.businessName }}",
        "message": "=Caller: {{ $json.callerPhone }}<br>Issue: {{ $json.issueSummary }}<br>Severity: {{ $json.severity }}<br>Action taken by assistant: {{ $json.action }}<br><br>Please follow up immediately.",
        "options": {},
        "onError": "continueErrorOutput"
      },
      "id": "eg4-email",
      "name": "Email On-Call Staff",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [660, 220],
      "onError": "continueErrorOutput",
      "credentials": {
        "gmailOAuth2": { "id": "PLACEHOLDER_GMAIL_CRED", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "g1",
              "leftValue": "={{ $json.sheetId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "eg10-has-sheet",
      "name": "Has Sheet ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "mode": "id", "value": "={{ $json.sheetId }}" },
        "sheetName": { "mode": "name", "value": "Emergencies" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $now.toISO() }}",
            "caller_phone": "={{ $json.callerPhone }}",
            "issue_summary": "={{ $json.issueSummary }}",
            "severity": "={{ $json.severity }}",
            "action_taken": "={{ $json.action }}"
          }
        },
        "options": {},
        "onError": "continueErrorOutput"
      },
      "id": "eg5-log-sheet",
      "name": "Log Emergency to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1100, 220],
      "onError": "continueErrorOutput",
      "notes": "Appends a row to this client's 'Emergencies' tab. Click through this node once after import to map columns.",
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER_GOOGLE_SHEETS_CRED", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": "={{ $json.slackChannel }}",
        "text": "=🚨 *EMERGENCY* — {{ $json.businessName }}\nCaller: {{ $json.callerPhone }}\nIssue: {{ $json.issueSummary }}\nSeverity: {{ $json.severity }} | Assistant action: {{ $json.action }}",
        "otherOptions": {},
        "onError": "continueErrorOutput"
      },
      "id": "eg6-slack",
      "name": "Notify Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1320, 300],
      "onError": "continueErrorOutput",
      "credentials": {
        "slackApi": { "id": "PLACEHOLDER_SLACK_CRED", "name": "Slack account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "audit_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "business_id", "fieldValue": "={{ $json.businessId }}" },
            { "fieldId": "event_type", "fieldValue": "emergency_alert_processed" }
          ]
        }
      },
      "id": "eg7-audit-log",
      "name": "Audit Log",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1540, 300],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "workflow_execution_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "workflow_name", "fieldValue": "emergency-alert" },
            { "fieldId": "business_id", "fieldValue": "={{ $json.businessId }}" },
            { "fieldId": "status", "fieldValue": "success" }
          ]
        }
      },
      "id": "eg8-workflow-log",
      "name": "Workflow Log",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1760, 300],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "workflow_errors",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "workflow_name", "fieldValue": "emergency-alert" },
            { "fieldId": "node_name", "fieldValue": "={{ $json.error?.node?.name || 'unknown' }}" },
            { "fieldId": "error_message", "fieldValue": "={{ $json.error?.message || 'unknown error' }}" },
            { "fieldId": "raw_payload", "fieldValue": "={{ JSON.stringify($json) }}" }
          ]
        }
      },
      "id": "eg9-handle-failure",
      "name": "Handle Failure",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [880, 480],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": "#automation-alerts",
        "text": "=⚠️ emergency-alert workflow failed for business {{ $json.businessId || 'unknown' }} — check workflow_errors table IMMEDIATELY, this is a safety-critical alert path.",
        "otherOptions": {}
      },
      "id": "eg11-alert-slack",
      "name": "Alert Engineering",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1100, 480],
      "credentials": {
        "slackApi": { "id": "PLACEHOLDER_SLACK_CRED", "name": "Slack account" }
      }
    }
  ],
  "connections": {
    "Emergency Logged Trigger": { "main": [[{ "node": "Normalize Payload", "type": "main", "index": 0 }]] },
    "Normalize Payload": { "main": [[{ "node": "SMS On-Call Staff", "type": "main", "index": 0 }]] },
    "SMS On-Call Staff": {
      "main": [
        [{ "node": "Email On-Call Staff", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Email On-Call Staff": {
      "main": [
        [{ "node": "Has Sheet ID?", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Has Sheet ID?": {
      "main": [
        [{ "node": "Log Emergency to Sheet", "type": "main", "index": 0 }],
        [{ "node": "Notify Team", "type": "main", "index": 0 }]
      ]
    },
    "Log Emergency to Sheet": {
      "main": [
        [{ "node": "Notify Team", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Notify Team": {
      "main": [
        [{ "node": "Audit Log", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Audit Log": { "main": [[{ "node": "Workflow Log", "type": "main", "index": 0 }]] },
    "Handle Failure": { "main": [[{ "node": "Alert Engineering", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
