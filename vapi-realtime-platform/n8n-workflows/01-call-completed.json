{
  "name": "[MASTER] Call Completed",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "call-completed",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "n1-webhook",
      "name": "Call Completed Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "call-completed-master"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "businessId", "type": "string", "value": "={{ $json.body.businessId }}" },
            { "id": "a2", "name": "callId", "type": "string", "value": "={{ $json.body.callId }}" },
            { "id": "a10", "name": "businessName", "type": "string", "value": "={{ $json.body.businessName }}" },
            { "id": "a3", "name": "transcript", "type": "string", "value": "={{ $json.body.transcript }}" },
            { "id": "a4", "name": "recordingUrl", "type": "string", "value": "={{ $json.body.recordingUrl }}" },
            { "id": "a5", "name": "customerName", "type": "string", "value": "={{ $json.body.customer.name }}" },
            { "id": "a6", "name": "customerPhone", "type": "string", "value": "={{ $json.body.customer.phone }}" },
            { "id": "a7", "name": "sheetId", "type": "string", "value": "={{ $json.body.sheetId }}" },
            { "id": "a8", "name": "durationSec", "type": "number", "value": "={{ $json.body.durationSec }}" },
            { "id": "a9", "name": "slackChannel", "type": "string", "value": "={{ $json.body.slackChannel || '#calls' }}" }
          ]
        },
        "options": {}
      },
      "id": "n2-normalize",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "s1",
              "leftValue": "={{ $json.sheetId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n16-has-sheet-1",
      "name": "Has Sheet ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300],
      "notes": "Skips logging to this business's Google Sheet if one hasn't been set up yet (businesses.google_sheet_id blank) — the rest of the workflow (AI summary, staff follow-up) still runs."
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "mode": "id", "value": "={{ $json.sheetId }}" },
        "sheetName": { "mode": "name", "value": "Call_Log" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["call_id"],
          "value": {
            "call_id": "={{ $json.callId }}",
            "timestamp": "={{ $now.toISO() }}",
            "customer_name": "={{ $json.customerName }}",
            "customer_phone": "={{ $json.customerPhone }}",
            "recording_url": "={{ $json.recordingUrl }}",
            "duration_sec": "={{ $json.durationSec }}",
            "transcript": "={{ $json.transcript }}"
          }
        },
        "options": {},
        "onError": "continueErrorOutput"
      },
      "id": "n17-log-call-initial",
      "name": "Log Call to Sheet (Initial)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [660, 220],
      "onError": "continueErrorOutput",
      "notes": "Writes the raw call record (transcript, recording, duration) to the client's own 'Call_Log' tab immediately — even if AI summarization below fails, the call itself is never lost. Click through this node once after import to map columns to your sheet.",
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER_GOOGLE_SHEETS_CRED", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": { "value": "gpt-4o-mini" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You summarize AI receptionist phone calls. Return ONLY valid JSON with keys: summary (string, 1-2 sentences), sentiment (one of positive, neutral, negative), action_items (array of strings, empty array if none)."
            },
            {
              "role": "user",
              "content": "=Transcript:\n{{ $json.transcript }}"
            }
          ]
        },
        "options": { "temperature": 0.2 },
        "onError": "continueErrorOutput"
      },
      "id": "n4-summarize",
      "name": "Generate Call Summary",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [880, 300],
      "onError": "continueErrorOutput",
      "credentials": {
        "openAiApi": { "id": "PLACEHOLDER_OPENAI_CRED", "name": "OpenAI account" }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "b1", "name": "summaryData", "type": "object", "value": "={{ JSON.parse($json.message.content) }}" },
            { "id": "b2", "name": "businessId", "type": "string", "value": "={{ $('Normalize Payload').item.json.businessId }}" },
            { "id": "b3", "name": "callId", "type": "string", "value": "={{ $('Normalize Payload').item.json.callId }}" },
            { "id": "b4", "name": "customerName", "type": "string", "value": "={{ $('Normalize Payload').item.json.customerName }}" },
            { "id": "b5", "name": "customerPhone", "type": "string", "value": "={{ $('Normalize Payload').item.json.customerPhone }}" },
            { "id": "b6", "name": "sheetId", "type": "string", "value": "={{ $('Normalize Payload').item.json.sheetId }}" },
            { "id": "b7", "name": "recordingUrl", "type": "string", "value": "={{ $('Normalize Payload').item.json.recordingUrl }}" },
            { "id": "b8", "name": "durationSec", "type": "number", "value": "={{ $('Normalize Payload').item.json.durationSec }}" },
            { "id": "b9", "name": "slackChannel", "type": "string", "value": "={{ $('Normalize Payload').item.json.slackChannel }}" }
          ]
        },
        "options": {},
        "onError": "continueErrorOutput"
      },
      "id": "n5-parse-summary",
      "name": "Parse Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1100, 300],
      "onError": "continueErrorOutput",
      "notes": "If the AI didn't return clean JSON this node errors instead of crashing the whole run — it now routes to Handle Failure just like every external call above it."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "s2",
              "leftValue": "={{ $json.sheetId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n18-has-sheet-2",
      "name": "Has Sheet ID? (2)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "mode": "id", "value": "={{ $json.sheetId }}" },
        "sheetName": { "mode": "name", "value": "Call_Log" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["call_id"],
          "value": {
            "call_id": "={{ $json.callId }}",
            "summary": "={{ $json.summaryData.summary }}",
            "sentiment": "={{ $json.summaryData.sentiment }}",
            "action_items": "={{ $json.summaryData.action_items.join('; ') }}"
          }
        },
        "options": {},
        "onError": "continueErrorOutput"
      },
      "id": "n19-log-call-summary",
      "name": "Log Call to Sheet (Add Summary)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1540, 220],
      "onError": "continueErrorOutput",
      "notes": "Updates the SAME row from 'Log Call to Sheet (Initial)' (matched by call_id) with the AI summary/sentiment/action items, rather than creating a second row.",
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER_GOOGLE_SHEETS_CRED", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.summaryData.sentiment }}",
              "rightValue": "negative",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.summaryData.action_items.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "n8-if-followup",
      "name": "Needs Follow-up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": "={{ $json.slackChannel }}",
        "text": "=📞 *Follow-up needed* — {{ $json.customerName }} ({{ $json.customerPhone }})\nSentiment: {{ $json.summaryData.sentiment }}\nSummary: {{ $json.summaryData.summary }}\nAction items: {{ $json.summaryData.action_items.join(', ') }}",
        "otherOptions": {},
        "onError": "continueErrorOutput"
      },
      "id": "n9-notify-team",
      "name": "Notify Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1980, 180],
      "onError": "continueErrorOutput",
      "credentials": {
        "slackApi": { "id": "PLACEHOLDER_SLACK_CRED", "name": "Slack account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "follow_up_tasks",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "business_id", "fieldValue": "={{ $json.businessId }}" },
            { "fieldId": "call_id", "fieldValue": "={{ $json.callId }}" },
            { "fieldId": "reason", "fieldValue": "={{ $json.summaryData.action_items.join('; ') || 'Negative sentiment call' }}" },
            { "fieldId": "status", "fieldValue": "open" }
          ]
        },
        "onError": "continueErrorOutput"
      },
      "id": "n10-create-task",
      "name": "Create Follow-up Task",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2200, 180],
      "onError": "continueErrorOutput",
      "notes": "Internal staff task tracking stays in Supabase — this is a platform-side to-do list, not part of the client-visible call history in their Sheet.",
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "audit_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "business_id", "fieldValue": "={{ $json.businessId }}" },
            { "fieldId": "event_type", "fieldValue": "call_completed_processed" },
            { "fieldId": "reference_id", "fieldValue": "={{ $json.callId }}" }
          ]
        }
      },
      "id": "n11-audit-log",
      "name": "Audit Log",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2420, 300],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "workflow_execution_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "workflow_name", "fieldValue": "call-completed" },
            { "fieldId": "business_id", "fieldValue": "={{ $json.businessId }}" },
            { "fieldId": "call_id", "fieldValue": "={{ $json.callId }}" },
            { "fieldId": "status", "fieldValue": "success" }
          ]
        }
      },
      "id": "n12-workflow-log",
      "name": "Workflow Log",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2640, 300],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "workflow_errors",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "workflow_name", "fieldValue": "call-completed" },
            { "fieldId": "node_name", "fieldValue": "={{ $json.error?.node?.name || 'unknown' }}" },
            { "fieldId": "error_message", "fieldValue": "={{ $json.error?.message || 'unknown error' }}" },
            { "fieldId": "raw_payload", "fieldValue": "={{ JSON.stringify($json) }}" }
          ]
        }
      },
      "id": "n13-handle-failure",
      "name": "Handle Failure",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [880, 560],
      "credentials": {
        "supabaseApi": { "id": "PLACEHOLDER_SUPABASE_CRED", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": "#automation-alerts",
        "text": "=⚠️ call-completed workflow failed for call {{ $json.callId || 'unknown' }} — check workflow_errors table.",
        "otherOptions": {}
      },
      "id": "n14-alert-slack",
      "name": "Alert Engineering",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1100, 560],
      "credentials": {
        "slackApi": { "id": "PLACEHOLDER_SLACK_CRED", "name": "Slack account" }
      }
    }
  ],
  "connections": {
    "Call Completed Trigger": { "main": [[{ "node": "Normalize Payload", "type": "main", "index": 0 }]] },
    "Normalize Payload": { "main": [[{ "node": "Has Sheet ID?", "type": "main", "index": 0 }]] },
    "Has Sheet ID?": {
      "main": [
        [{ "node": "Log Call to Sheet (Initial)", "type": "main", "index": 0 }],
        [{ "node": "Generate Call Summary", "type": "main", "index": 0 }]
      ]
    },
    "Log Call to Sheet (Initial)": {
      "main": [
        [{ "node": "Generate Call Summary", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Generate Call Summary": {
      "main": [
        [{ "node": "Parse Summary", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Parse Summary": {
      "main": [
        [{ "node": "Has Sheet ID? (2)", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Has Sheet ID? (2)": {
      "main": [
        [{ "node": "Log Call to Sheet (Add Summary)", "type": "main", "index": 0 }],
        [{ "node": "Needs Follow-up?", "type": "main", "index": 0 }]
      ]
    },
    "Log Call to Sheet (Add Summary)": {
      "main": [
        [{ "node": "Needs Follow-up?", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Needs Follow-up?": {
      "main": [
        [{ "node": "Notify Team", "type": "main", "index": 0 }],
        [{ "node": "Audit Log", "type": "main", "index": 0 }]
      ]
    },
    "Notify Team": {
      "main": [
        [{ "node": "Create Follow-up Task", "type": "main", "index": 0 }],
        [{ "node": "Handle Failure", "type": "main", "index": 0 }]
      ]
    },
    "Create Follow-up Task": { "main": [[{ "node": "Audit Log", "type": "main", "index": 0 }]] },
    "Audit Log": { "main": [[{ "node": "Workflow Log", "type": "main", "index": 0 }]] },
    "Handle Failure": { "main": [[{ "node": "Alert Engineering", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
