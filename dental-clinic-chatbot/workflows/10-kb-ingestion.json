{
  "name": "M10 — Knowledge Base Ingestion (Drive → Pinecone)",
  "nodes": [
    {
      "id": "note10",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1000, -320],
      "parameters": {
        "width": 720,
        "height": 380,
        "color": 4,
        "content": "## M10 KB Ingestion\nRun manually (or on a schedule). Reads files from ONE Drive subfolder, chunks them, embeds with text-embedding-3-small, and upserts to Pinecone under the clinic namespace.\n\n### Run once per category subfolder\nSet `folder_id` to a subfolder (e.g. FAQ) and `category` to its name, then run. This gives each vector correct `category` metadata. (Recursive auto-crawl = Future Upgrade.)\n\n### Re-ingesting\nThe Pinecone node appends new vectors; to avoid duplicates when re-uploading changed docs, enable 'Clear Namespace' on the Pinecone node OR delete the namespace first. Pinecone index dimension MUST be 1536.\n\nAfter import: set OpenAI, Google Drive, Pinecone credentials; fill the Config node."
      }
    },
    { "id": "man10", "name": "Run Manually", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [-1000, 140], "parameters": {} },
    {
      "id": "cfg10",
      "name": "Ingestion Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-780, 140],
      "parameters": {
        "assignments": { "assignments": [
          { "id": "g1", "name": "clinic_name", "value": "{{clinic_name}}", "type": "string" },
          { "id": "g2", "name": "pinecone_index", "value": "dental-clinic-kb", "type": "string" },
          { "id": "g3", "name": "pinecone_namespace", "value": "smilecare_knowledge_base", "type": "string" },
          { "id": "g4", "name": "folder_id", "value": "{{DRIVE_SUBFOLDER_ID}}", "type": "string" },
          { "id": "g5", "name": "category", "value": "FAQ", "type": "string" }
        ] },
        "options": {}
      }
    },
    {
      "id": "search10",
      "name": "List Files In Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [-560, 140],
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"'\" + $json.folder_id + \"' in parents and trashed = false and mimeType != 'application/vnd.google-apps.folder'\" }}",
        "returnAll": true,
        "filter": {},
        "options": {}
      },
      "credentials": { "googleDriveOAuth2Api": { "id": "REPLACE_ME_DRIVE_CRED_ID", "name": "Google Drive account" } }
    },
    {
      "id": "download10",
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [-320, 140],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": { "__rl": true, "mode": "id", "value": "={{ $json.id }}" },
        "options": { "googleFileConversion": { "conversion": { "docsToFormat": "text/plain" } }, "binaryPropertyName": "data" }
      },
      "credentials": { "googleDriveOAuth2Api": { "id": "REPLACE_ME_DRIVE_CRED_ID", "name": "Google Drive account" } }
    },
    {
      "id": "meta10",
      "name": "Prep Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 140],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Ingestion Config').first().json;\nconst f = $json;\nreturn { json: {\n  clinic_name: cfg.clinic_name,\n  category: cfg.category,\n  source_document: f.name || f.originalFilename || 'unknown',\n  source_url: f.webViewLink || '',\n  last_updated: $now.toISODate(),\n  chunk_id: (f.name || 'doc')\n}, binary: $binary };"
      }
    },
    {
      "id": "emb10",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [200, 360],
      "parameters": { "model": "text-embedding-3-small", "options": {} },
      "credentials": { "openAiApi": { "id": "REPLACE_ME_OPENAI_CRED_ID", "name": "OpenAi account" } }
    },
    {
      "id": "split10",
      "name": "Recursive Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [420, 520],
      "parameters": { "chunkSize": 1000, "chunkOverlap": 150, "options": {} }
    },
    {
      "id": "loader10",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [320, 360],
      "parameters": {
        "dataType": "binary",
        "binaryMode": "specificField",
        "binaryDataKey": "data",
        "textSplittingMode": "custom",
        "options": {
          "metadata": { "metadataValues": [
            { "name": "clinic_name", "value": "={{ $json.clinic_name }}" },
            { "name": "category", "value": "={{ $json.category }}" },
            { "name": "source_document", "value": "={{ $json.source_document }}" },
            { "name": "source_url", "value": "={{ $json.source_url }}" },
            { "name": "last_updated", "value": "={{ $json.last_updated }}" }
          ] }
        }
      }
    },
    {
      "id": "pineins10",
      "name": "Pinecone — Insert",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.1,
      "position": [200, 140],
      "parameters": {
        "mode": "insert",
        "pineconeIndex": { "__rl": true, "mode": "id", "value": "={{ $('Ingestion Config').first().json.pinecone_index }}" },
        "options": { "pineconeNamespace": "={{ $('Ingestion Config').first().json.pinecone_namespace }}", "clearNamespace": false }
      },
      "credentials": { "pineconeApi": { "id": "REPLACE_ME_PINECONE_CRED_ID", "name": "PineconeApi account" } }
    }
  ],
  "connections": {
    "Run Manually": { "main": [[{ "node": "Ingestion Config", "type": "main", "index": 0 }]] },
    "Ingestion Config": { "main": [[{ "node": "List Files In Folder", "type": "main", "index": 0 }]] },
    "List Files In Folder": { "main": [[{ "node": "Download File", "type": "main", "index": 0 }]] },
    "Download File": { "main": [[{ "node": "Prep Metadata", "type": "main", "index": 0 }]] },
    "Prep Metadata": { "main": [[{ "node": "Pinecone — Insert", "type": "main", "index": 0 }]] },
    "Embeddings OpenAI": { "ai_embedding": [[{ "node": "Pinecone — Insert", "type": "ai_embedding", "index": 0 }]] },
    "Default Data Loader": { "ai_document": [[{ "node": "Pinecone — Insert", "type": "ai_document", "index": 0 }]] },
    "Recursive Text Splitter": { "ai_textSplitter": [[{ "node": "Default Data Loader", "type": "ai_textSplitter", "index": 0 }]] }
  }
}
